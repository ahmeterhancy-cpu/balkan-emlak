# Canlı .env şablonu. Sunucuda public_html/balkan_app/.env olarak OLUŞTURUN
# (Dosya Yöneticisi → Ayarlar → Show Hidden Files). Deploy bu dosyaya dokunmaz.
# Bu şablonda gerçek parola YOK; depoya yalnız şablon girer.

APP_NAME="Balkan Emlak ve Yönetim"
APP_ENV=production
APP_DEBUG=false
# Yerelde: php artisan key:generate --show  → yapıştırın, BİR DAHA DEĞİŞTİRMEYİN
APP_KEY=
APP_URL=https://ALANADI

APP_LOCALE=tr
APP_TIMEZONE=Europe/Istanbul
APP_FALLBACK_LOCALE=tr
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel yetkiyi @localhost verir; 127.0.0.1 yazarsanız "Access denied" olur
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Başvuru bildirimleri için (boşsa e-posta gitmez, başvurular yine panele düşer)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Yedek zip AES-256 parolası — uzun, rastgele; APP_KEY'den ayrı, sunucu DIŞINDA da saklayın
YEDEK_PAROLA=
YEDEK_SAKLA=14

# İlk sistem yöneticisi (deploy'da balkan:kurulum açar; yalnız hiç yönetici yokken).
# İlk girişten sonra ILK_YONETICI_PAROLA satırını SİLİN.
ILK_YONETICI_EPOSTA=
ILK_YONETICI_PAROLA=
ILK_YONETICI_AD="Sistem Yöneticisi"
